<?xml version="1.0" encoding="UTF-8"?>
<!-- Jafra preset "low" (generated by gen_presets.py). Long soak tests / many pods on a laptop. Est. 0.5-1.5% CPU, 2-6 MB/min.
     Same event set in all three presets; only periods/thresholds/throttles differ.
     Works on JDK 17-25: events unknown to the running JDK are ignored by JFR (validated on 17.0.20, 21.0.12, 25.0.4).
     NativeMemoryUsage* need -XX:NativeMemoryTracking=summary. CPUTimeSample (JDK 25, Linux, experimental) overlaps async-profiler ctimer. -->
<configuration version="2.0" label="Jafra low" description="Long soak tests / many pods on a laptop. Est. 0.5-1.5% CPU, 2-6 MB/min." provider="Jafra">
  <event name="jdk.ExecutionSample">
    <setting name="enabled">true</setting>
    <setting name="period">50 ms</setting>
  </event>
  <event name="jdk.NativeMethodSample">
    <setting name="enabled">true</setting>
    <setting name="period">100 ms</setting>
  </event>
  <event name="jdk.CPUTimeSample">
    <setting name="enabled">true</setting>
    <setting name="throttle">100/s</setting>
    <setting name="stackTrace">true</setting>
  </event>
  <event name="jdk.CPUTimeSamplesLost">
    <setting name="enabled">true</setting>
  </event>
  <event name="jdk.CPULoad">
    <setting name="enabled">true</setting>
    <setting name="period">5 s</setting>
  </event>
  <event name="jdk.ThreadCPULoad">
    <setting name="enabled">true</setting>
    <setting name="period">10 s</setting>
  </event>
  <event name="jdk.ThreadContextSwitchRate">
    <setting name="enabled">true</setting>
    <setting name="period">30 s</setting>
  </event>
  <event name="jdk.GCCPUTime">
    <setting name="enabled">true</setting>
  </event>
  <event name="jdk.ContainerConfiguration">
    <setting name="enabled">true</setting>
    <setting name="period">beginChunk</setting>
  </event>
  <event name="jdk.ContainerCPUUsage">
    <setting name="enabled">true</setting>
    <setting name="period">15 s</setting>
  </event>
  <event name="jdk.ContainerCPUThrottling">
    <setting name="enabled">true</setting>
    <setting name="period">15 s</setting>
  </event>
  <event name="jdk.ContainerMemoryUsage">
    <setting name="enabled">true</setting>
    <setting name="period">15 s</setting>
  </event>
  <event name="jdk.ContainerIOUsage">
    <setting name="enabled">true</setting>
    <setting name="period">15 s</setting>
  </event>
  <event name="jdk.ResidentSetSize">
    <setting name="enabled">true</setting>
    <setting name="period">5 s</setting>
  </event>
  <event name="jdk.PhysicalMemory">
    <setting name="enabled">true</setting>
    <setting name="period">30 s</setting>
  </event>
  <event name="jdk.SwapSpace">
    <setting name="enabled">true</setting>
    <setting name="period">30 s</setting>
  </event>
  <event name="jdk.NetworkUtilization">
    <setting name="enabled">true</setting>
    <setting name="period">15 s</setting>
  </event>
  <event name="jdk.CPUInformation">
    <setting name="enabled">true</setting>
    <setting name="period">beginChunk</setting>
  </event>
  <event name="jdk.OSInformation">
    <setting name="enabled">true</setting>
    <setting name="period">beginChunk</setting>
  </event>
  <event name="jdk.CPUTimeStampCounter">
    <setting name="enabled">true</setting>
    <setting name="period">beginChunk</setting>
  </event>
  <event name="jdk.GarbageCollection">
    <setting name="enabled">true</setting>
    <setting name="threshold">0 ms</setting>
  </event>
